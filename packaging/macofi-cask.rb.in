# Generated by `make release` from packaging/macofi-cask.rb.in; edit that file instead.
cask "macofi" do
  version "@VERSION@"
  sha256 "@DMG_SHA256@"

  url "@DMG_BASE@/Macofi-#{version}.dmg"
  name "Macofi"
  desc "Configurable wofi/rofi-style application launcher"
  homepage "https://github.com/@REPO@"

  depends_on macos: ">= :ventura"

  app "Macofi.app"
  binary "#{appdir}/Macofi.app/Contents/MacOS/macofi"

  uninstall quit: "dev.macofi"

  zap trash: [
    "~/.config/macofi",
    "~/.local/state/macofi",
  ]

  caveats <<~EOS
    Open Macofi from Applications to run it in the background (default hotkey alt+space),
    and add it to System Settings › General › Login Items to start it at login.
  EOS
end
