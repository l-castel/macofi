# Generated by `make release` from packaging/macofi.rb.in; edit that file instead.
class Macofi < Formula
  desc "Configurable wofi/rofi-style application launcher for macOS"
  homepage "https://github.com/@REPO@"
  url "@SRC_URL@"
  sha256 "@SRC_SHA256@"
  license "MIT"
  head "https://github.com/@REPO@.git", branch: "main"

  depends_on macos: :ventura

  def install
    system "make", "app"
    prefix.install "build/Macofi.app"
    bin.install_symlink prefix/"Macofi.app/Contents/MacOS/macofi"
    pkgshare.install "config.example.toml", "matugen"
  end

  service do
    run [opt_prefix/"Macofi.app/Contents/MacOS/macofi", "--daemon"]
    keep_alive true
    log_path var/"log/macofi.log"
    error_log_path var/"log/macofi.log"
  end

  def caveats
    <<~EOS
      Run it in the background with a global hotkey (default alt+space):
        brew services start macofi
      Or bind `macofi` (one-shot) or `macofi --show` in skhd/AeroSpace/etc.

      Config: ~/.config/macofi/config.toml. To start from the full example:
        mkdir -p ~/.config/macofi && cp #{opt_pkgshare}/config.example.toml ~/.config/macofi/config.toml

      Theme: the [colors] in your config (Tokyo Night by default). If matugen is
      installed, the first daemon start asks whether macofi may add its template to
      your matugen config (or run: macofi --setup-matugen).
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/macofi --version")
    assert_match "[window]", shell_output("#{bin}/macofi --print-config")
  end
end
